{
  "include": [
    "etc",
    "src",
    ".storybook/*.ts",
    "eslint.config.js",
    "prettier.config.js",
    "vite.config.ts",
    "rslib.config.ts"
  ],
  "extends": [
    "./node_modules/@tsconfig/strictest/tsconfig.json",
    "./node_modules/@tsconfig/node26/tsconfig.json"
  ],
  "compilerOptions": {
    "rootDir": ".",

    "module": "esnext",
    "moduleResolution": "bundler",

    "lib": [
      "DOM",
      "DOM.Iterable",
      "ESNext",
      // Service worker APIs.
      "WebWorker"
    ],
    "types": ["node", "vitest/globals"],

    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,

    // Catch syntax that single-file compilers such as SWC and Babel cannot handle:
    // https://rsbuild.dev/guide/basic/typescript#isolatedmodules
    "isolatedModules": true,

    // Keep compiled output small by stripping comments.
    "removeComments": true,

    "noEmit": true,

    // Speed up CI and skip dependency declaration checks.
    "skipLibCheck": true,

    // Keep supporting side-effect style imports without declaration files
    "noUncheckedSideEffectImports": false,

    // Include the JavaScript ESLint and Prettier configs.
    "allowJs": true,

    // TODO Remove these exceptions and fix more errors one day
    "noImplicitAny": false,
    "noPropertyAccessFromIndexSignature": false
  }
}
